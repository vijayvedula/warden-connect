.DS_Store
/target
/fuzz/target
# `daemon/*` are separate workspaces, each with its own target dir. `/target` above is
# root-anchored and does not reach them.
/daemon/*/target
/fuzz/Cargo.lock
/fuzz/artifacts

# Generated by scripts/sbom.py; CI uploads it as an artifact rather than committing it.
warden-connect.cdx.json

# Recorded video. `scripts/record-pitch.mjs` writes 4,680 frames and ~11MB of MP4 here, and
# every re-record would be a new permanent copy in git history — the film has been re-cut a
# dozen times. The small looping GIF the README needs lives in docs/media/; the MP4s belong
# on a release, which is where this repository already puts binaries.
/build

# Artefacts the drills mint. `oidc-drill.sh` runs in `mktemp -d` and makes its own, but an
# `evil.jwt` from an older revision of that script had been committed at the repository root
# and sat there — a stray signed token in a security product's tree, referenced by nothing.
*.jwt
