      "document": "{\"entity\":\"spiffe://org/ns/tools/sa/vectors\",\"items\":[{\"annotations\":{\"destructiveHint\":true,\"idempotentHint\":false,\"openWorldHint\":true,\"readOnlyHint\":false,\"title\":\"T\"},\"name\":\"t\"}],\"kind\":\"mcp_tools\",\"meta\":{},\"v\":1}",
      "manifest": "sha256:fa4acf1aad01888bed01a35dccb1d9296962ca000c2878f5620e2a82e9ef63b2",
